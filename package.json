{
  "name": "spicetify-extensions",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "test": "node tools/test-extensions.mjs && node --test \"tools/test/*.test.mjs\" && node tools/sync-shared.mjs --check && pnpm -C tools/compat test",
    "sync": "node tools/sync-shared.mjs",
    "compat": "pnpm -C tools/compat compat",
    "site": "pnpm -C site",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7"
  }
}
